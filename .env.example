# Anthropic
ANTHROPIC_API_KEY=your_key_here

# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# OpenAI (for embeddings only - text-embedding-3-small)
OPENAI_API_KEY=your_key_here

# ElevenLabs (AI text-to-speech). Optional — works on the free tier. When the
# key is missing or the monthly quota is exhausted, the app automatically falls
# back to the browser's built-in voice.
ELEVENLABS_API_KEY=your_key_here
ELEVENLABS_VOICE_ID=onwK4e9ZLuTAKqWW03F9

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXTAUTH_SECRET=your_secret_here

# Models
CLAUDE_MODEL=claude-haiku-4-5-20251001
CLAUDE_MAX_TOKENS=500
EMBEDDING_MODEL=text-embedding-3-small
